# Copy to .env and fill in (never commit .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TA_REPO_PATH=/path/to/trading-agent
DMS_REPO_PATH=/path/to/decision-making-service
TES_REPO_PATH=/path/to/trade-execution-system

PORTFOLIO_PATH=/path/to/my-portfolio
E2E_STANDARDS_PATH=/path/to/my-portfolio/agent-orchestration/e2e-standards

ORCHESTRATOR_PORT=8000
MAX_AGENT_ITERATIONS=5

# Hosted demo: serve a bundled sample report from /api/run instead of running
# the offline suite, for servers without the private Go repos. Off by default;
# set to 1/true/yes/on to enable.
DEMO_MODE=
