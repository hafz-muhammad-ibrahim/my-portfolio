# Copy to config.env and edit for your local setup. config.env is untracked.

# Service URLs
DMS_URL=http://localhost:8080
TES_URL=http://localhost:8081
REDIS_ADDR=localhost:6379

# Repo paths (for go test scripts)
TA_REPO=/path/to/trading-agent
DMS_REPO=/path/to/decision-making-service
TES_REPO=/path/to/trade-execution-system

# Thresholds
DMS_QUEUE_WARN=410
TA_QUEUE_WARN=820
METRICS_TIMEOUT_SEC=5

# Deployment-specific names used by the online checks. Leave empty to skip
# those checks; fill in to enable them.
OPP_KEY_PATTERN=
DMS_QUEUE_METRIC=
TES_OUTBOX_METRIC=
